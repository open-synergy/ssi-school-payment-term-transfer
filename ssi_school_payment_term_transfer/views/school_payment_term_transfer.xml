<odoo>
<record id="school_payment_term_transfer_view_search" model="ir.ui.view">
    <field name="name">school_payment_term_transfer - search</field>
    <field name="model">school_payment_term_transfer</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="student_id" />
                <field name="enrollment_id" />
                <field name="reason_id" />
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_reason_id"
                            string="Reason"
                            context="{'group_by': 'reason_id'}"
                        />
                    <filter
                            name="group_by_academic_year_id"
                            string="Academic Year"
                            context="{'group_by': 'academic_year_id'}"
                        />
                    <filter
                            name="group_by_academic_term_id"
                            string="Academic Term"
                            context="{'group_by': 'academic_term_id'}"
                        />
                    <filter
                            name="group_by_student_id"
                            string="Student"
                            context="{'group_by': 'student_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_payment_term_transfer_view_tree" model="ir.ui.view">
    <field name="name">school_payment_term_transfer - tree</field>
    <field name="model">school_payment_term_transfer</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="student_id" />
                <field name="enrollment_id" />
                <field name="reason_id" />
                <field name="source_term_id" />
                <field name="destination_term_id" />
                <field name="amount_total" sum="Total" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_payment_term_transfer_view_form" model="ir.ui.view">
    <field name="name">school_payment_term_transfer - form</field>
    <field name="model">school_payment_term_transfer</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="student_id" />
                <field name="enrollment_id" />
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <field name="reason_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="amount_total" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="transfer" string="Transfer Detail">
                    <group name="transfer_term">
                        <field name="allowed_term_ids" invisible="1" />
                        <field
                                name="source_term_id"
                                domain="[('id','in',allowed_term_ids)]"
                            />
                        <field
                                name="destination_term_id"
                                domain="[('id','in',allowed_term_ids)]"
                            />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="allowed_source_detail_ids" invisible="1" />
                            <field
                                    name="source_detail_id"
                                    domain="[('id','in',allowed_source_detail_ids)]"
                                />
                            <field name="product_id" readonly="1" />
                            <field name="amount_before" readonly="1" />
                            <field name="amount" />
                            <field name="amount_after" readonly="1" />
                            <field name="full_transfer" readonly="1" />
                            <field name="destination_detail_id" readonly="1" />
                        </tree>
                        <form>
                            <group>
                                <field name="allowed_source_detail_ids" invisible="1" />
                                <field
                                        name="source_detail_id"
                                        domain="[('id','in',allowed_source_detail_ids)]"
                                    />
                                <field name="product_id" readonly="1" />
                                <field name="amount_before" readonly="1" />
                                <field name="amount" />
                                <field name="amount_after" readonly="1" />
                                <field name="full_transfer" readonly="1" />
                                <field name="destination_detail_id" readonly="1" />
                            </group>
                        </form>
                    </field>
                    <group name="transfer_note" string="Note">
                        <field name="note" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_payment_term_transfer_action" model="ir.actions.act_window">
    <field name="name">Payment Term Transfers</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_payment_term_transfer</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_payment_term_transfer_menu"
        name="Payment Term Transfers"
        parent="ssi_school.menu_school_student_activity"
        action="school_payment_term_transfer_action"
        groups="school_payment_term_transfer_viewer_group"
        sequence="25"
    />

</odoo>
