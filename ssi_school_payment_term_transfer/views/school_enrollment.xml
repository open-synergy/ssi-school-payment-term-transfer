<odoo>
<record
        id="school_payment_term_transfer_open_transfer_action"
        model="ir.actions.act_window"
    >
    <field name="name">Payment Term Transfers</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_payment_term_transfer</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('enrollment_id', '=', active_id)]</field>
    <field name="context">{'default_enrollment_id': active_id}</field>
</record>

<record id="school_enrollment_view_form_transfer" model="ir.ui.view">
    <field name="name">school_enrollment - form - transfer</field>
    <field name="model">school_enrollment</field>
    <field name="inherit_id" ref="ssi_school.school_enrollment_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                        class="oe_stat_button"
                        type="action"
                        name="%(school_payment_term_transfer_open_transfer_action)d"
                        icon="fa-exchange"
                    >
                    <field name="transfer_count" string="Transfers" widget="statinfo" />
                </button>
            </xpath>
        </data>
    </field>
</record>
</odoo>
