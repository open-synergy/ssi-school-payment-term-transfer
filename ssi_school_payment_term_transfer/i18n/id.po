#. module: ssi_school_payment_term_transfer
#: model:ir.model.fields,help:ssi_school_payment_term_transfer.field_school_payment_term_transfer__activity_state
#: model:ir.model.fields,help:ssi_school_payment_term_transfer.field_school_payment_term_transfer_reason__activity_state
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"Status berdasarkan aktivitas\n"
"Terlambat: Batas waktu sudah lewat\n"
"Hari Ini: Tanggal aktivitas hari ini\n"
"Terjadwal: Aktivitas mendatang."

#. module: ssi_school_payment_term_transfer
