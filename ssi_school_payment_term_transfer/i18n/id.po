#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Document has no line\n"
"Solution: Add at least one line before continuing\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Dokumen tidak memiliki baris\n"
"Solusi: Tambahkan setidaknya satu baris sebelum melanjutkan\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Payment Term '%s' already has a Customer Invoice\n"
"Solution: Cancel this document; a term already invoiced can no longer be transferred\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Termin Pembayaran '%s' sudah memiliki Faktur Pelanggan\n"
"Solusi: Batalkan dokumen ini; termin yang sudah difaktur tidak dapat ditransfer lagi\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Payment Term '%s' does not belong to Enrollment '%s'\n"
"Solution: Select a Source/Destination Term that belongs to the same Enrollment\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Termin Pembayaran '%s' bukan milik Pendaftaran '%s'\n"
"Solusi: Pilih Termin Sumber/Tujuan yang berasal dari Pendaftaran yang sama\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' already has a Customer Invoice Line\n"
"Solution: Cancel this document; an already-invoiced line can no longer be transferred\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' sudah memiliki Baris Faktur Pelanggan\n"
"Solusi: Batalkan dokumen ini; baris yang sudah difaktur tidak dapat ditransfer lagi\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' does not belong to the Source Term\n"
"Solution: Select a Source Detail that belongs to the Source Term\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' bukan milik Termin Sumber\n"
"Solusi: Pilih Detail Sumber yang berasal dari Termin Sumber\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' has UoM Quantity %s, which is not 1\n"
"Solution: Only source details with a UoM Quantity of exactly 1 can be transferred\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' memiliki Kuantitas UoM %s, yang bukan 1\n"
"Solusi: Hanya detail sumber dengan Kuantitas UoM tepat 1 yang dapat ditransfer\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' is already voided\n"
"Solution: Select a Source Detail that is not already voided\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' sudah dialihkan\n"
"Solusi: Pilih Detail Sumber yang belum dialihkan\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Confirm/Done payment term transfer\n"
"Database ID: %s\n"
"Problem: Source Term and Destination Term must both be set and different\n"
"Solution: Select a Source Term and a Destination Term that differ\n"
msgstr ""
"\n"
"Konteks: Konfirmasi/Selesaikan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Termin Sumber dan Termin Tujuan harus sama-sama diisi dan berbeda\n"
"Solusi: Pilih Termin Sumber dan Termin Tujuan yang berbeda\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer billing source\n"
"Database ID: %s\n"
"Problem: No billing source record set for Source Type '%s'\n"
"Solution: Select the record matching the selected Source Type\n"
msgstr ""
"\n"
"Konteks: Atur sumber penagihan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Tidak ada rekaman sumber penagihan yang diisi untuk Jenis Sumber '%s'\n"
"Solusi: Pilih rekaman yang sesuai dengan Jenis Sumber yang dipilih\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line amount\n"
"Database ID: %s\n"
"Problem: Amount %s exceeds Amount Before %s\n"
"Solution: Enter an amount no greater than Amount Before\n"
msgstr ""
"\n"
"Konteks: Atur jumlah baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jumlah %s melebihi Jumlah Sebelum %s\n"
"Solusi: Masukkan jumlah yang tidak lebih besar dari Jumlah Sebelum\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line amount\n"
"Database ID: %s\n"
"Problem: Amount %s is not greater than zero\n"
"Solution: Enter an amount greater than zero\n"
msgstr ""
"\n"
"Konteks: Atur jumlah baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jumlah %s tidak lebih besar dari nol\n"
"Solusi: Masukkan jumlah yang lebih besar dari nol\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line source detail\n"
"Database ID: %s\n"
"Problem: No source detail set for this line\n"
"Solution: Select the source detail this line moves the amount from\n"
msgstr ""
"\n"
"Konteks: Atur detail sumber baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail sumber belum diisi untuk baris ini\n"
"Solusi: Pilih detail sumber tempat baris ini memindahkan jumlahnya\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line source detail\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' is already targeted by open document '%s'\n"
"Solution: Wait until the other document is Done/Cancelled, or pick a\n"
"different Source Detail\n"
msgstr ""
"\n"
"Konteks: Atur detail sumber baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' sudah menjadi target dokumen terbuka '%s'\n"
"Solusi: Tunggu hingga dokumen lain Selesai/Dibatalkan, atau pilih\n"
"Detail Sumber yang berbeda\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line source detail\n"
"Database ID: %s\n"
"Problem: Source Detail '%s' is already used by another line of this document\n"
"Solution: Select a different Source Detail, or edit the existing line instead\n"
msgstr ""
"\n"
"Konteks: Atur detail sumber baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Detail Sumber '%s' sudah digunakan oleh baris lain pada dokumen ini\n"
"Solusi: Pilih Detail Sumber yang berbeda, atau ubah baris yang sudah ada\n"

#. module: ssi_school_payment_term_transfer
#: code:addons/ssi_school_payment_term_transfer/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer source/destination\n"
"Database ID: %s\n"
"Problem: Destination Term '%s' is the same as the Source Term\n"
"Solution: Select a different payment term as the transfer destination\n"
msgstr ""
"\n"
"Konteks: Atur sumber/tujuan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Termin Tujuan '%s' sama dengan Termin Sumber\n"
"Solusi: Pilih termin pembayaran yang berbeda sebagai tujuan transfer\n"

