<odoo>
<record
        id="school_payment_term_transfer_open_transfer_action_admission"
        model="ir.actions.act_window"
    >
    <field name="name">Payment Term Transfers</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_payment_term_transfer</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('admission_id', '=', active_id)]</field>
    <field name="context">{'default_admission_id': active_id}</field>
</record>

<record id="school_admission_view_form_transfer" model="ir.ui.view">
    <field name="name">school_admission - form - transfer</field>
    <field name="model">school_admission</field>
    <field name="inherit_id" ref="ssi_school_admission.school_admission_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                        class="oe_stat_button"
                        type="action"
                        name="%(school_payment_term_transfer_open_transfer_action_admission)d"
                        icon="fa-exchange"
                    >
                    <field name="transfer_count" string="Transfers" widget="statinfo" />
                </button>
            </xpath>
        </data>
    </field>
</record>

<record
        id="school_payment_term_transfer_action_admission"
        model="ir.actions.act_window"
    >
    <field name="name">Payment Term Transfers</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_payment_term_transfer</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('admission_id', '!=', False)]</field>
</record>

<menuitem
        id="school_payment_term_transfer_menu_admission"
        name="Payment Term Transfers"
        parent="ssi_school_admission.menu_school_admission"
        action="school_payment_term_transfer_action_admission"
        groups="ssi_school_payment_term_transfer.school_payment_term_transfer_viewer_group"
        sequence="25"
    />
</odoo>
