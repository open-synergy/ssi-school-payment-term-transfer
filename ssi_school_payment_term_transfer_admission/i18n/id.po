#. module: ssi_school_payment_term_transfer_admission
#: code:addons/ssi_school_payment_term_transfer_admission/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line source detail\n"
"Database ID: %s\n"
"Problem: Source Type is Admission but Source Detail is also set\n"
"Solution: Clear Source Detail, or select Admission Source Detail instead\n"
msgstr ""
"\n"
"Konteks: Atur detail sumber baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jenis Sumber adalah Penerimaan tetapi Detail Sumber juga diisi\n"
"Solusi: Kosongkan Detail Sumber, atau pilih Detail Sumber Penerimaan\n"

#. module: ssi_school_payment_term_transfer_admission
#: code:addons/ssi_school_payment_term_transfer_admission/models/school_payment_term_transfer_line.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer line source detail\n"
"Database ID: %s\n"
"Problem: Source Type is Enrollment but Admission Source Detail is also set\n"
"Solution: Clear Admission Source Detail, or select Source Detail instead\n"
msgstr ""
"\n"
"Konteks: Atur detail sumber baris transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jenis Sumber adalah Pendaftaran tetapi Detail Sumber Penerimaan juga diisi\n"
"Solusi: Kosongkan Detail Sumber Penerimaan, atau pilih Detail Sumber\n"

#. module: ssi_school_payment_term_transfer_admission
#: code:addons/ssi_school_payment_term_transfer_admission/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer source/destination\n"
"Database ID: %s\n"
"Problem: Source Type is Admission but an Enrollment-path field is also set\n"
"Solution: Clear Enrollment, Source Term and Destination Term\n"
msgstr ""
"\n"
"Konteks: Atur sumber/tujuan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jenis Sumber adalah Penerimaan tetapi isian jalur Pendaftaran juga diisi\n"
"Solusi: Kosongkan Pendaftaran, Termin Sumber dan Termin Tujuan\n"

#. module: ssi_school_payment_term_transfer_admission
#: code:addons/ssi_school_payment_term_transfer_admission/models/school_payment_term_transfer.py:0
#, python-format
msgid ""
"\n"
"Context: Set payment term transfer source/destination\n"
"Database ID: %s\n"
"Problem: Source Type is Enrollment but an Admission-path field is also set\n"
"Solution: Clear Admission, Admission Source Term and Admission\n"
"Destination Term\n"
msgstr ""
"\n"
"Konteks: Atur sumber/tujuan transfer termin pembayaran\n"
"ID Basis Data: %s\n"
"Masalah: Jenis Sumber adalah Pendaftaran tetapi isian jalur Penerimaan juga diisi\n"
"Solusi: Kosongkan Penerimaan, Termin Sumber Penerimaan dan Termin\n"
"Tujuan Penerimaan\n"

